# (Required) Reddit API credentials. Create an app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here

# (Optional) How many hours a thread keeps getting rechecked for new comments and score updates
# THREAD_TTL_HOURS=24

# (Optional) How many minutes between rechecking active threads for updates. Total time scales with your hardware and how many threads are active at once
# SCHEDULER_INTERVAL_MINUTES=60

# (Optional) Backfill threads from this YYYY-MM-DD date forward on startup, leave unset to skip
# BACKFILL_DATE=

# (Optional) Timezone for the web UI's displayed dates and for container log timestamps, accepts any tz database identifier e.g. America/New_York
# TZ=UTC

# (Optional) User ID the container runs as, match the owner of your ./data directory
# PUID=1000

# (Optional) Group ID the container runs as, match the group that owns your ./data directory
# PGID=1000
