# Reddit API credentials (required)
# Create an app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here

# How many hours a thread stays active before being archived (optional)
# Default: 24
THREAD_TTL_HOURS=36

# Backfill missing threads on startup before the scheduler begins (optional)
# Set to 'auto' for Feb 1 of the current year, or a specific YYYY-MM-DD date.
# Leave unset to skip backfill entirely.
# BACKFILL_DATE=auto

# How often the scheduler runs in minutes (optional)
# Default: 60 -- each run takes 2-3 minutes per thread so set accordingly
SCHEDULER_INTERVAL_MINUTES=30

# Timezone for displaying dates and times in the web UI (optional)
# Default: UTC -- accepts any tz database identifier e.g. America/New_York
# TZ=America/New_York
